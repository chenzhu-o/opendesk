{
  "name": "@vitalops/opendesk-sdk",
  "version": "0.3.0",
  "description": "OpenDesk by VitalOps — open-source computer-use MCP server that lets AI agents see and control macOS, Windows and Linux desktops, locally or across paired machines.",
  "mcpName": "io.github.vitalops/opendesk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "opendesk-sdk": "bin/opendesk-mcp.js",
    "opendesk-js": "bin/opendesk.js",
    "opendesk-js-mcp": "bin/opendesk-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "opendesk",
    "computer-use",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "desktop-automation",
    "ai-agent",
    "claude",
    "accessibility",
    "screenshot",
    "ocr",
    "rpa",
    "remote-control",
    "screen-memory",
    "recall",
    "desktop-history"
  ],
  "homepage": "https://github.com/vitalops/opendesk#readme",
  "bugs": {
    "url": "https://github.com/vitalops/opendesk/issues"
  },
  "author": "VitalOps",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "bonjour-service": "^1.2.1",
    "clipboardy": "^4.0.0",
    "jimp": "^0.22.10",
    "msgpackr": "^1.10.1",
    "node-cron": "^3.0.0",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalops/opendesk.git",
    "directory": "js"
  },
  "optionalDependencies": {}
}
